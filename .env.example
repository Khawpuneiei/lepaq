# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. .env.local is gitignored; .env.example is not.
# ---------------------------------------------------------------------------

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses RLS. Never prefix this with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Claude writes the speaker mapping and the meeting report.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_FALLBACK_MODEL=claude-sonnet-5-5
# "low" | "medium" | "high" | "xhigh" | "max". Raise if coach output reads thin.
LLM_EFFORT=medium

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Transcription
# ---------------------------------------------------------------------------

# "jobs" (default): the whole recording goes to the GPU service (WhisperLah +
#   pyannote community-1 + WeSpeaker ResNet34 on Modal) as one job, which
#   calls back to /api/transcription/callback. Needs the three WHISPERLAH_URL /
#   WHISPERLAH_TOKEN / CALLBACK_SECRET values, NEXT_PUBLIC_APP_URL, and
#   migrations 0004-0005.
# "whisperlah": same models on a local server (singlish-asr/scripts/serve),
#   sent part by part. Needs WHISPERLAH_URL (token optional) and migration 0004.
TRANSCRIBE_BACKEND=jobs
# Base URL of the service. For "jobs", the Modal app URL
# (https://<workspace>--<app>.modal.run); for "whisperlah", the local server,
# usually http://127.0.0.1:8765.
WHISPERLAH_URL=
# Bearer token the service expects.
WHISPERLAH_TOKEN=
# Shared with the GPU service; signs its callbacks (HMAC-SHA256).
CALLBACK_SECRET=
# Vercel Cron sends this to /api/cron/transcription-jobs.
CRON_SECRET=
# "room" transcribes everyone in the room; "near" only the lapel-mic wearer.
WHISPERLAH_MODE=room

# ---------------------------------------------------------------------------
# Long-audio handling (optional — sensible defaults are compiled in)
# ---------------------------------------------------------------------------

# Largest file the browser will accept, in MB. The Supabase free tier caps
# storage objects at 50MB; raising this needs a paid Supabase plan.
NEXT_PUBLIC_MAX_UPLOAD_MB=50

# Per-part backend (TRANSCRIBE_BACKEND=whisperlah) only; "jobs" sends the
# whole recording. Audio longer than this is split into chunks before
# transcription. Each chunk is re-encoded to mono 48kbps MP3, so ~10 min
# lands near 3.5MB.
AUDIO_CHUNK_SECONDS=600

# How many chunks to transcribe at once. Raising it finishes sooner but
# risks overloading the server and the 300s Vercel function ceiling.
AUDIO_CHUNK_CONCURRENCY=3

# ---------------------------------------------------------------------------
# Local development convenience
# ---------------------------------------------------------------------------

# "true" enables /api/dev/login, which mints a real Supabase session for
# OWNER_EMAIL and signs you in with no password. Useful when the owner account
# has no password set, or you just do not want to type one thirty times a day.
#
# It is not a security hole you have to remember to close: the route and the
# button both require NODE_ENV !== "production", which `next build` sets, so
# they are dead on Vercel regardless of what this is set to.
DEV_AUTH_BYPASS=false

# Used by the dev sign-in above, and by scripts/e2e.ts and scripts/bootstrap.ts.
OWNER_EMAIL=
OWNER_USER_ID=
